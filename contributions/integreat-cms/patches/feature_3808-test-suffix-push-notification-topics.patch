From aebc6138bfe16acd39109ade6a47464d7dd82a19 Mon Sep 17 00:00:00 2001
From: Simon Spitzer <simon.spitzer@live.de>
Date: Wed, 4 Nov 2026 07:30:24 +0000
Subject: [PATCH] Append -test suffix to push notification topics on test
 systems

When the TEST setting is enabled, push notifications are sent to the topic
{region}-{language}-{channel}-test instead of {region}-{language}-{channel},
so that notifications sent from the test CMS do not reach production users.
The channel in the data payload stays unchanged.

Fixes #3808

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../firebase_api/firebase_api_client.py       | 18 ++++++-
 .../release_notes/current/unreleased/3808.yml |  2 +
 .../firebase_api/test_firebase_api_client.py  | 47 +++++++++++++++++++
 3 files changed, 66 insertions(+), 1 deletion(-)
 create mode 100644 integreat_cms/release_notes/current/unreleased/3808.yml

diff --git a/integreat_cms/firebase_api/firebase_api_client.py b/integreat_cms/firebase_api/firebase_api_client.py
index b274c74..8b1b80b 100644
--- a/integreat_cms/firebase_api/firebase_api_client.py
+++ b/integreat_cms/firebase_api/firebase_api_client.py
@@ -105,6 +105,22 @@ class FirebaseApiClient:
                 return False
         return True
 
+    def get_topic(self, pnt: PushNotificationTranslation, region: Region) -> str:
+        """
+        Get the FCM topic to which the push notification translation is sent
+
+        On test systems (see :setting:`TEST`), the suffix ``-test`` is appended to the topic, so that push
+        notifications sent from the test system do not reach end users of the production system.
+
+        :param pnt: The prepared push notification translation to be sent
+        :param region: The region for which to send the prepared push notification translation
+        :return: The FCM topic
+        """
+        topic = f"{region.slug}-{pnt.language.slug}-{self.push_notification.channel}"
+        if settings.TEST:
+            topic += "-test"
+        return topic
+
     def send_pn(self, pnt: PushNotificationTranslation, region: Region) -> bool:
         """
         Send single push notification translation
@@ -117,7 +133,7 @@ class FirebaseApiClient:
         payload = {
             "validate_only": settings.DEBUG,
             "message": {
-                "topic": f"{region.slug}-{pnt.language.slug}-{self.push_notification.channel}",
+                "topic": self.get_topic(pnt, region),
                 "notification": {"title": pnt.title, "body": pnt.text},
                 "data": {
                     "news_id": str(pnt.id),
diff --git a/integreat_cms/release_notes/current/unreleased/3808.yml b/integreat_cms/release_notes/current/unreleased/3808.yml
new file mode 100644
index 0000000..f3fec13
--- /dev/null
+++ b/integreat_cms/release_notes/current/unreleased/3808.yml
@@ -0,0 +1,2 @@
+en: Push notifications sent from test systems are now sent to separate test channels, so they no longer reach users of the production app.
+de: Push-Benachrichtigungen von Testsystemen werden jetzt an separate Testkanäle gesendet und erreichen so keine Nutzer*innen der Produktiv-App mehr.
diff --git a/tests/firebase_api/test_firebase_api_client.py b/tests/firebase_api/test_firebase_api_client.py
index 7921b13..fbbbc20 100644
--- a/tests/firebase_api/test_firebase_api_client.py
+++ b/tests/firebase_api/test_firebase_api_client.py
@@ -319,3 +319,50 @@ class TestFirebaseApiClient:
             "augsburg-en-news",
             "augsburg-de-news",
         }
+
+    @pytest.mark.django_db
+    @pytest.mark.parametrize(
+        ("is_test_system", "expected_targets"),
+        [
+            (False, {"augsburg-en-news", "augsburg-de-news"}),
+            (True, {"augsburg-en-news-test", "augsburg-de-news-test"}),
+        ],
+    )
+    def test_test_suffix_appended_on_test_system(
+        self,
+        settings: Settings,
+        load_test_data: None,
+        requests_mock: Mocker,
+        is_test_system: bool,
+        expected_targets: set[str],
+    ) -> None:
+        """
+        Tests that the suffix ``-test`` is appended to the topics if and only if the system is a test system
+
+        :param settings: The Django settings
+        :param load_test_data: The fixture providing the test data (see :meth:`~tests.conftest.load_test_data`)
+        :param requests_mock: Fixture for mocking requests, see :doc:`requests-mock:pytest`
+        :param is_test_system: The value of the ``TEST`` setting
+        :param expected_targets: The topics the push notification is expected to be sent to
+        """
+        targets = set()
+        groups = set()
+
+        def evaluate_request(request: _RequestObjectProxy, context: _Context) -> object:
+            targets.add(request.json()["message"]["topic"])
+            groups.add(request.json()["message"]["data"]["group"])
+            return self.response_mock_data["200_success"]
+
+        requests_mock.post(settings.FCM_URL, json=evaluate_request, status_code=200)
+
+        settings.FCM_ENABLED = True
+        settings.TEST = is_test_system
+
+        notification = PushNotification.objects.get(pk=1)
+
+        pns = FirebaseApiClient(notification)
+        assert pns.send_all()
+
+        assert targets == expected_targets
+        # The channel in the data payload should not be modified
+        assert groups == {"news"}
