From e12b0d9a6a9940019d192d300e0ea446fefe4342 Mon Sep 17 00:00:00 2001
From: Simon Spitzer <simon.spitzer@live.de>
Date: Wed, 4 Nov 2026 07:29:30 +0000
Subject: [PATCH] Show licenses link only next to the current version in
 release notes

The template used forloop.first of the inner loop, which is true for the
first version of every year. Compare against the installed version instead.

Fixes #4207

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../release_notes/release_notes.html          | 46 ++++++++-------
 .../release_notes/current/unreleased/4207.yml |  2 +
 .../release_notes/test_release_notes_view.py  | 57 +++++++++++++++++++
 3 files changed, 85 insertions(+), 20 deletions(-)
 create mode 100644 integreat_cms/release_notes/current/unreleased/4207.yml
 create mode 100644 tests/cms/views/release_notes/test_release_notes_view.py

diff --git a/integreat_cms/cms/templates/release_notes/release_notes.html b/integreat_cms/cms/templates/release_notes/release_notes.html
index a71e8bb..ac74644 100644
--- a/integreat_cms/cms/templates/release_notes/release_notes.html
+++ b/integreat_cms/cms/templates/release_notes/release_notes.html
@@ -6,28 +6,34 @@
         <h1 class="heading !mb-3">
             <i icon-name="scroll"></i> {% translate "Release notes" %}
         </h1>
-        {% for year, versions in release_notes.items %}
-            {% for version, notes in versions.items %}
-                {% if version == "unreleased" %}
-                    {% if notes %}
-                        <h2 class="text-xl mb-2">
-                            <span class="italic">{% translate "Unreleased" %}</span>
+        {% comment %}
+            The global "version" context variable is shadowed by the loop variable below,
+            so store the currently installed version under a different name.
+        {% endcomment %}
+        {% with current_version=version %}
+            {% for year, versions in release_notes.items %}
+                {% for version, notes in versions.items %}
+                    {% if version == "unreleased" %}
+                        {% if notes %}
+                            <h2 class="text-xl mb-2">
+                                <span class="italic">{% translate "Unreleased" %}</span>
+                            </h2>
+                        {% endif %}
+                    {% else %}
+                        <h2 class="text-2xl mb-2">
+                            <a href="https://github.com/digitalfabrik/integreat-cms/releases/tag/{{ version }}"
+                               class="hover:underline"
+                               target="_blank"
+                               rel="noopener noreferrer">{{ version }}</a>
+                            {% if version == current_version and sbom %}
+                                (<a class="text-blue-500 underline"
+   href="{% url 'public:open_source_licenses' %}">{% translate "Licenses of used software" %}</a>)
+                            {% endif %}
                         </h2>
                     {% endif %}
-                {% else %}
-                    <h2 class="text-2xl mb-2">
-                        <a href="https://github.com/digitalfabrik/integreat-cms/releases/tag/{{ version }}"
-                           class="hover:underline"
-                           target="_blank"
-                           rel="noopener noreferrer">{{ version }}</a>
-                        {% if forloop.first and sbom %}
-                            (<a class="text-blue-500 underline"
-   href="{% url 'public:open_source_licenses' %}">{% translate "Licenses of used software" %}</a>)
-                        {% endif %}
-                    </h2>
-                {% endif %}
-                {% include "release_notes/version.html" %}
+                    {% include "release_notes/version.html" %}
+                {% endfor %}
             {% endfor %}
-        {% endfor %}
+        {% endwith %}
     </div>
 {% endblock content %}
diff --git a/integreat_cms/release_notes/current/unreleased/4207.yml b/integreat_cms/release_notes/current/unreleased/4207.yml
new file mode 100644
index 0000000..4e498c7
--- /dev/null
+++ b/integreat_cms/release_notes/current/unreleased/4207.yml
@@ -0,0 +1,2 @@
+en: The link to the licenses of used software is now only shown next to the current version in the release notes.
+de: Der Link zu den Lizenzen der verwendeten Software wird in den Release Notes nur noch bei der aktuellen Version angezeigt.
diff --git a/tests/cms/views/release_notes/test_release_notes_view.py b/tests/cms/views/release_notes/test_release_notes_view.py
new file mode 100644
index 0000000..444bc55
--- /dev/null
+++ b/tests/cms/views/release_notes/test_release_notes_view.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import re
+from unittest.mock import patch
+
+import pytest
+from django.contrib.auth import get_user_model
+from django.test.client import Client
+from django.urls import reverse
+
+from integreat_cms import __version__
+from integreat_cms.cms.views.release_notes.release_notes_view import ReleaseNotesView
+
+
+@pytest.mark.django_db
+def test_licenses_link_only_shown_for_current_version(load_test_data: None) -> None:
+    """
+    Test that the link to the licenses of used software is only shown next to the current version,
+    and not next to the most recent version of every year (see issue #4207)
+
+    :param load_test_data: The fixture providing the test data (see :meth:`~tests.conftest.load_test_data`)
+    """
+    client = Client()
+    client.force_login(get_user_model().objects.get(username="root"))
+
+    with patch.object(
+        ReleaseNotesView, "does_sbom_exist_for_this_version", return_value=True
+    ):
+        response = client.get(reverse("release_notes"))
+    assert response.status_code == 200
+
+    licenses_url = reverse("public:open_source_licenses")
+    headings = re.findall(r"<h2.*?</h2>", response.content.decode(), flags=re.DOTALL)
+    headings_with_licenses_link = [
+        heading for heading in headings if licenses_url in heading
+    ]
+
+    assert len(headings_with_licenses_link) == 1
+    assert f">{__version__}</a>" in headings_with_licenses_link[0]
+
+
+@pytest.mark.django_db
+def test_licenses_link_not_shown_without_sbom(load_test_data: None) -> None:
+    """
+    Test that the link to the licenses of used software is not shown if no SBOM exists
+
+    :param load_test_data: The fixture providing the test data (see :meth:`~tests.conftest.load_test_data`)
+    """
+    client = Client()
+    client.force_login(get_user_model().objects.get(username="root"))
+
+    with patch.object(
+        ReleaseNotesView, "does_sbom_exist_for_this_version", return_value=False
+    ):
+        response = client.get(reverse("release_notes"))
+    assert response.status_code == 200
+    assert reverse("public:open_source_licenses") not in response.content.decode()
-- 
