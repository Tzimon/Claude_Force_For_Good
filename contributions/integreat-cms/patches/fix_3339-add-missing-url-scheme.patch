diff --git a/integreat_cms/static/src/js/forms/add-missing-url-scheme.ts b/integreat_cms/static/src/js/forms/add-missing-url-scheme.ts
new file mode 100644
index 0000000..411b566
--- /dev/null
+++ b/integreat_cms/static/src/js/forms/add-missing-url-scheme.ts
@@ -0,0 +1,29 @@
+/**
+ * This file prepends "https://" to the value of URL input fields if the user did not enter a scheme.
+ * Otherwise, the browser's built-in validation rejects values like "www.example.com" with an unhelpful error.
+ */
+
+import { addMissingUrlScheme } from "../utils/url";
+
+const completeUrl = (target: EventTarget | null) => {
+    if (target instanceof HTMLInputElement && target.type === "url" && !target.readOnly && !target.disabled) {
+        const completedUrl = addMissingUrlScheme(target.value);
+        if (completedUrl !== target.value) {
+            target.value = completedUrl;
+        }
+    }
+};
+
+// Use event delegation, so that dynamically added input fields are covered as well.
+// The "change" event is fired when the field loses focus after the value was modified.
+document.addEventListener("change", (event) => completeUrl(event.target), true);
+// When the form is submitted by pressing enter, the browser validates the field before it loses focus
+document.addEventListener(
+    "keydown",
+    (event) => {
+        if (event.key === "Enter") {
+            completeUrl(event.target);
+        }
+    },
+    true
+);
diff --git a/integreat_cms/static/src/js/utils/url.ts b/integreat_cms/static/src/js/utils/url.ts
new file mode 100644
index 0000000..282b49b
--- /dev/null
+++ b/integreat_cms/static/src/js/utils/url.ts
@@ -0,0 +1,24 @@
+/**
+ * Matches values which already start with a URL scheme, e.g. "https:", "mailto:" or "tel:".
+ * Dots are deliberately not allowed in the scheme, so that a host with a port
+ * (e.g. "www.example.com:8080") is not mistaken for a scheme.
+ */
+const SCHEME_REGEX = /^[a-z][a-z0-9+-]*:/i;
+
+/**
+ * Prepend "https://" to a URL if it does not contain a scheme yet,
+ * e.g. "www.example.com" becomes "https://www.example.com".
+ *
+ * @param value The URL entered by the user
+ * @returns The URL including a scheme
+ */
+export const addMissingUrlScheme = (value: string): string => {
+    const trimmedValue = value.trim();
+    if (!trimmedValue || SCHEME_REGEX.test(trimmedValue)) {
+        return value;
+    }
+    if (trimmedValue.startsWith("//")) {
+        return `https:${trimmedValue}`;
+    }
+    return `https://${trimmedValue}`;
+};
